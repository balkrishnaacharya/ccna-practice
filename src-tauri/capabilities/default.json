{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the desktop application window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "process:default",
    "updater:default",
    "core:app:default",
    "notification:default",
    "dialog:default",
    "window-state:default",
    "fs:default",
    "fs:allow-write-text-file"
  ]
}
