{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCNA Practice",
  "version": "0.2.0",
  "identifier": "com.ccnapractice.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CCNA Practice",
        "width": 900,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1QzkyNEIwNjk3QjAxMEYKUldRUEFYdHBzQ1RKZFF3bEJ2Nkp1VkUxL0YvQVE4dnRFeUs2OW9KU2RBbTA4YzJwTllXenFKY2YK",
      "endpoints": [
        "https://github.com/balkrishnaacharya/ccna-practice/releases/latest/download/latest.json"
      ]
    }
  }
}